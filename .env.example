# Rydeu Credentials
RYDEU_EMAIL=your-email@example.com
RYDEU_PASSWORD=your-password

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Scraper Settings
SCRAPE_INTERVAL=300000
HEADLESS=true
DEBUG=false

# Local-only debug aid: records ~30s of video of the auction board whenever
# a new auction is found (see recordAuctionBoard in src/auction.js). Needs
# Playwright's browser installed (`npx playwright install chromium`) -
# never set this in CI/GitHub Actions secrets, it's not wired in there.
RECORD_ON_AUCTION=false

# GitHub Actions (set as secrets in repo)
# CONFIG_JSON=base64-encoded-config
# PAYLOAD_JSON=base64-encoded-payload
